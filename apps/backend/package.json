{
	"name": "@notetaker-v2/backend",
	"version": "1.0.0",
	"private": true,
	"description": "",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"auth:generate": "pnpm dlx auth@latest generate --config src/modules/auth/auth.cli.ts --output src/database/schema/auth.ts",
		"build": "tsc -p tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "dotenv -e .env -- drizzle-kit migrate",
		"db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"dev": "tsx watch --env-file=.env src/server.ts",
		"start": "node dist/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.3",
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.1",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/sensible": "^6.0.5",
		"@fastify/swagger": "^9.8.1",
		"@fastify/swagger-ui": "^6.1.1",
		"@notetaker-v2/contracts": "workspace:*",
		"better-auth": "^1.7.3",
		"dotenv": "^17.4.2",
		"drizzle-orm": "1.0.0-rc.4",
		"fastify": "^5.12.3",
		"fastify-plugin": "^6.0.0",
		"fastify-type-provider-zod": "^7.0.0",
		"pg": "^8.23.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/pg": "^8.23.1",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "1.0.0-rc.4",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
