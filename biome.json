{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git"
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/dist",
			"!!**/build",
			"!!**/coverage",
			"!!**/.turbo",
			"!!**/.vite",
			"!!**/playwright-report",
			"!!**/test-results"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"useEditorconfig": true,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"lineWidth": 100,
		"bracketSpacing": true,
		"trailingNewline": true
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "all",
			"project": "all",
			"test": "all",
			"playwright": "all",
			"types": "all"
		},
		"rules": {
			"preset": "recommended",
			"a11y": "error",
			"correctness": "error",
			"security": "error",
			"complexity": "warn",
			"performance": "warn",
			"style": {
				"noNonNullAssertion": "error",
				"useImportType": "error",
				"useNamingConvention": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImplicitAnyLet": "error",
				"noUnusedExpressions": "error",
				"useAwait": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useExhaustiveSwitchCases": "error"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedPackageJson": "on"
			}
		}
	}
}
